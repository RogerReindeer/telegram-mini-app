NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
BOT_TOKEN=replace_me
SESSION_SECRET=replace_with_a_long_random_secret
FRONTEND_ORIGIN=http://localhost:5173
CONTENT_VERSION=qinghe-v3.1
DEV_TELEGRAM_USER_ID=990001
DEV_TELEGRAM_USERNAME=local_tester

ADMIN_PASSWORD=replace_with_a_strong_admin_password

ACTION_TIME_SCALE=0.1
PRESENCE_TTL_SECONDS=120
AVAILABILITY_UTC_OFFSET=8

# Telegram Stars commerce. Keep disabled until migration 005 is applied and
# active package prices are configured in commerce_products.
STARS_PAYMENTS_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_telegram_webhook_secret

# Qinghe -> Reader v242 server-to-server delivery.
READER_COMMERCE_ENABLED=false
READER_API_URL=https://reader.example.com
READER_COMMERCE_SHARED_SECRET=replace_with_the_same_32_plus_character_secret_as_reader
READER_COMMERCE_SERVICE_ID=qinghe-api
READER_COMMERCE_TIMEOUT_SECONDS=8
READER_COMMERCE_WORKER_INTERVAL_MS=5000
READER_COMMERCE_BATCH_SIZE=5
READER_COMMERCE_PROCESSING_TIMEOUT_SECONDS=300
